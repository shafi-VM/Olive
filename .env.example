# ──────────────────────────────────────────────────────────────
# Olive — environment configuration
# Copy to `.env` and fill in values. Used by Docker Compose + apps.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development

# Postgres
POSTGRES_USER=olive
POSTGRES_PASSWORD=olive
POSTGRES_DB=olive
# When running apps on the host, host is localhost; inside Docker it is `postgres`.
DATABASE_URL=postgresql://olive:olive@localhost:5432/olive?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Service ports
API_PORT=4000
INGESTION_PORT=4001

# SDK -> ingestion endpoint
INGESTION_URL=http://localhost:4001

# Frontend -> API
NEXT_PUBLIC_API_URL=http://localhost:4000

# LLM providers
# Gemini is the default/working provider. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — enables the OpenAI provider if set.
OPENAI_API_KEY=
# Optional — enables the OpenRouter provider (OpenAI-compatible gateway).
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default provider/model: gemini | openrouter | openai | mock
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash
