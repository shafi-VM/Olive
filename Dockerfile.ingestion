# Ingestion service — log intake API + BullMQ worker (one process).
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app
COPY . .

RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @olive/db run generate

EXPOSE 4001
CMD ["pnpm", "--filter", "@olive/ingestion", "run", "start"]
